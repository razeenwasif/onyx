{
  "name": "electron-desktop",
  "productName": "Electron",
  "version": "0.1.0",
  "description": "Electron Desktop — an Obsidian-style markdown vault app for the Electron vault format.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Razeen Wasif",
    "email": "razeen.wasif66@gmail.com"
  },
  "homepage": "https://github.com/razeenwasif/onyx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/razeenwasif/onyx.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:linux": "electron-vite build && electron-builder --linux",
    "pack:win": "electron-vite build && electron-builder --win",
    "pack:win:docker": "bash scripts/pack-win-docker.sh",
    "build:scribe": "bash scripts/build-scribe.sh",
    "pack:mac": "npm run build:scribe && electron-vite build && electron-builder --mac",
    "pack:mac:arm64": "npm run build:scribe && electron-vite build && electron-builder --mac --arm64",
    "pack:mac:x64": "npm run build:scribe && electron-vite build && electron-builder --mac --x64",
    "pack:mac:universal": "npm run build:scribe && electron-vite build && electron-builder --mac --universal",
    "install:mac": "bash scripts/install-mac.sh",
    "generate-icons": "bash scripts/generate-icons.sh",
    "test": "vitest run",
    "test:clicks": "cd native/click-test && node-gyp rebuild --loglevel=error && node run.cjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.1",
    "@replit/codemirror-vim": "^6.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "node-gyp": "^11.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "md.onyx.desktop",
    "productName": "Electron",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Office",
      "synopsis": "Obsidian-style markdown vault",
      "description": "A markdown vault app with live preview, a WebGL graph view, canvas boards and a local AI assistant.",
      "desktop": {
        "Name": "Electron",
        "GenericName": "Markdown vault",
        "Comment": "Obsidian-style markdown vault",
        "Categories": "Office;TextEditor;",
        "Keywords": "notes;markdown;vault;graph;obsidian;",
        "MimeType": "text/markdown;",
        "StartupWMClass": "Electron"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Electron",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15.0",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "build/icon.png",
          "to": "icon.png"
        },
        {
          "from": "scribe-embed",
          "to": "scribe",
          "filter": [
            "libScribeEmbed.dylib",
            "scribe_bridge.node",
            "scribe-icon.png"
          ]
        },
        {
          "from": "scribe-embed",
          "to": ".",
          "filter": [
            "*.bundle/**/*"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
